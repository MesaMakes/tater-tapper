rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each player's private cloud save. Only they can read or write it.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Public leaderboard. Signed-in players can read it;
    // each player can only write their own row.
    match /leaderboard/{uid} {
      function validRow() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'team', 'allTime', 'clicks', 'fidgetClicks', 'achievements', 'updatedAt'])
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 20
          && d.team in ['', 'russet', 'yukon', 'red', 'purple']
          && d.allTime is number && d.allTime >= 0
          && d.clicks is number && d.fidgetClicks is number && d.achievements is number
          && d.updatedAt == request.time;
      }

      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid && validRow();
      allow update: if request.auth != null && request.auth.uid == uid && validRow()
        && request.resource.data.allTime >= resource.data.allTime          // scores never go down
        && request.resource.data.fidgetClicks >= resource.data.fidgetClicks
        && request.time > resource.data.updatedAt + duration.value(10, 's'); // no spamming writes
      allow delete: if false;   // you can still delete rows yourself in the Firebase console
    }

    // Team totals: everyone adds their own taps to their team, a little at a time.
    match /teams/{team} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && team in ['russet', 'yukon', 'red', 'purple']
        && request.resource.data.keys().hasOnly(['taps'])
        && request.resource.data.taps is number && request.resource.data.taps <= 2000;
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly(['taps'])
        && request.resource.data.taps >= resource.data.taps
        && request.resource.data.taps <= resource.data.taps + 2000;
      allow delete: if false;
    }

    // Raids: one shared boss per raid window. Anyone signed in can start it at full health
    // and chip away at it; nobody can heal it or hit it more than 400 times in one write.
    match /raids/{raidId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['boss', 'maxHp', 'hp', 'starts', 'ends', 'teams'])
        && request.resource.data.maxHp == 10000
        && request.resource.data.hp == 10000
        && request.resource.data.teams == { 'russet': 0, 'yukon': 0, 'red': 0, 'purple': 0 };
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hp', 'teams'])
        && request.resource.data.hp < resource.data.hp
        && request.resource.data.hp >= resource.data.hp - 400
        && request.resource.data.teams.keys().hasOnly(['russet', 'yukon', 'red', 'purple']);
      allow delete: if false;
    }
  }
}
